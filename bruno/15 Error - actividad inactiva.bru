meta {
  name: Error - actividad inactiva
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNotaInactiva}}",
    "valor": 4
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: contains no está activa
}
