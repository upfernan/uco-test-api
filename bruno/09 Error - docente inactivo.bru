meta {
  name: Error - docente inactivo
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: none
}

body:json {
  {
    "idDocente": "{{idDocenteInactivo}}",
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNota}}",
    "valor": 4
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: contains no está activo
}
