meta {
  name: Registrar nota 3.5
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNota}}",
    "valor": 3.5
  }
}

assert {
  res.status: eq 201
  res.body.respuestaExitosa: eq true
}

docs {
  El docente sale del token, no del cuerpo. Si la nota ya existe, responde 400 (regla 6).
}
