meta {
  name: Error - nota mayor a 5
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNota}}",
    "valor": 5.01
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: contains entre 0 y 5
}
