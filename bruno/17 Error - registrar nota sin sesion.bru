meta {
  name: Error - registrar nota sin sesion
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: none
}

body:json {
  {
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNota}}",
    "valor": 4
  }
}

assert {
  res.status: eq 401
}
