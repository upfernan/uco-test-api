meta {
  name: Registrar cuenta del docente demo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Docente Demo",
    "correo": "{{correoDocente}}",
    "clave": "{{claveDemo}}",
    "rol": "DOCENTE"
  }
}

docs {
  La primera vez responde 201. Si la cuenta ya existe responde 400 (regla: correo unico); es esperado.
}
