meta {
  name: Error - estudiante sin grupo
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudianteSinGrupo}}",
    "idNota": "{{idNota}}",
    "valor": 4
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: contains no pertenece al grupo
}
