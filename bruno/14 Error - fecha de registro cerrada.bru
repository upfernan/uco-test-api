meta {
  name: Error - fecha de registro cerrada
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNotaCerrada}}",
    "valor": 4
  }
}

assert {
  res.status: eq 400
  res.body.mensajes[0]: contains no está vigente
}
