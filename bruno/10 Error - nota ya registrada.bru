meta {
  name: Error - nota ya registrada
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNota}}",
    "valor": 3.5
  }
}

assert {
  res.status: eq 400
  res.body.respuestaExitosa: eq false
  res.body.mensajes[0]: contains ya tiene registrada
}
