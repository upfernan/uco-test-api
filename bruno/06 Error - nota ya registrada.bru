meta {
  name: Error - nota ya registrada
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: none
}

body:json {
  {
    "idDocente": "{{idDocente}}",
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNota}}",
    "valor": 3.5
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: contains ya tiene registrada
}
