meta {
  name: Error - fecha de registro cerrada
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/notas-estudiantes
  body: json
  auth: none
}

body:json {
  {
    "idDocente": "{{idDocente}}",
    "idGrupo": "{{idGrupo}}",
    "idEstudiante": "{{idEstudiante}}",
    "idNota": "{{idNotaCerrada}}",
    "valor": 4
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: contains no está vigente
}
